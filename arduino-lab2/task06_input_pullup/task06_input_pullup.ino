// Задание 6: вход D8 с подтягивающим резистором, кнопка между D8 и GND
void setup() {
  Serial.begin(9600);
  DDRB  = 0b00000000;   // все выводы порта в режиме чтения
  PORTB = 0b00000001;   // подключить подтягивающий резистор к PB0 (D8)
}

void loop() {
  Serial.println(((PINB >> 0) & 1), BIN);
  delay(1000);
}
